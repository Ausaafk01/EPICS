# Gram Vikas Backend Configuration

# Server
PORT=5001
NODE_ENV=development

# Database Connection (PostgreSQL 15+)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/gram_vikas_db
DB_HOST=localhost
DB_PORT=5432
DB_NAME=gram_vikas_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_MAX_CONNECTIONS=20
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=2000

# Authentication & Security
JWT_SECRET=super-secret-gram-vikas-jwt-key-min-32-chars-long!
JWT_EXPIRES_IN=24h

# Multi-Tenancy
DEFAULT_PANCHAYAT_ID=a0000000-0000-0000-0000-000000000001
